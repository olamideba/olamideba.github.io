---
import '../styles.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
}

const { title, description, path, image = '/images/olamide.jpg' } = Astro.props;
const url = new URL(path, 'https://olamideba.github.io').href;
const imageUrl = new URL(image, 'https://olamideba.github.io').href;
const current = path === '/' ? 'research' : path.startsWith('/engineering') ? 'engineering' : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <link rel="preload" href="/fonts/neco-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/x-icon" href="/images/favicon-2.ico" />
  </head>
  <body>
    <div class="page">
      <nav class="site-nav" aria-label="Site">
        <a href="/" class="site-name">Olamide Balogun</a>
        <span class="nav-links">
          <a href="/" aria-current={current === 'research' ? 'page' : undefined}>Research</a>
          <a href="/engineering/" aria-current={current === 'engineering' ? 'page' : undefined}>Engineering</a>
        </span>
      </nav>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a href="mailto:olamidebalogun174@gmail.com">olamidebalogun174@gmail.com</a>
        <span>Updated November 2026</span>
      </footer>
    </div>
  </body>
</html>
