---
import Base from '../../layouts/Base.astro';
import { projects } from '../../../data/projects';

export function getStaticPaths() {
  return projects
    .filter((project) => project.sections)
    .map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const links = project.links ?? {};
const linkLabels: Record<string, string> = {
  github: 'Code',
  live: 'Live',
  video: 'Demo video',
  writeup: 'Blog post',
  doi: 'Paper',
};

// Per-case results for the Parallax benchmark, from
// parallax/backend/tests/benchmark/out/report.md (run of 2026-07-07).
const parallaxRows = [
  ['Correct decisions (of 19)', '16', '17'],
  ['Planted traps accepted', '2', '1'],
  ['Tokens', '104,895', '620,795'],
  ['LLM calls', '45', '300'],
  ['Wall-clock time (s)', '530', '1,266'],
];
---

<Base
  title={`${project.title} · Olamide Balogun`}
  description={project.summary}
  path={`/projects/${project.id}/`}
  image={`/images/og-${project.id}.jpg`}
>
  <article class="article">
    <header class="article-head">
      <h1>{project.title}</h1>
      <p class="meta">{project.context}</p>
      <p>{project.summary}</p>
      <ul class="link-row">
        {Object.entries(links).map(([k, href]) => <li><a href={href}>{linkLabels[k] ?? k}</a></li>)}
      </ul>
    </header>

    {project.sections!.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.paragraphs.map((para) => <p>{para}</p>)}
        {project.id === 'parallax' && s.heading === 'Result' && (
          <table>
            <thead>
              <tr><th></th><th class="num">Single agent</th><th class="num">Debate</th></tr>
            </thead>
            <tbody>
              {parallaxRows.map(([label, a, b]) => (
                <tr><td>{label}</td><td class="num">{a}</td><td class="num">{b}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    ))}

    {project.id === 'parallax' && (
      <section>
        <h2>References</h2>
        <p class="small">Liang, T. et al. (2024). Encouraging Divergent Thinking in Large Language Models through Multi-Agent Debate. <em>EMNLP 2024</em>.</p>
        <p class="small">Chan, C.-M. et al. (2024). ChatEval: Towards Better LLM-based Evaluators through Multi-Agent Debate. <em>ICLR 2024</em>.</p>
      </section>
    )}

    <p class="small" style="margin-top: 2.5rem"><a href="/engineering/">All engineering work</a> · <a href="/">Research</a></p>
  </article>
</Base>
